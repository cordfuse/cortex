{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Starter .claude/settings.json template for fresh cortex deployments. Copy to .claude/settings.json on initial setup. Permissive defaults appropriate for a personal cortex repo where the scribe needs broad filesystem + git + bash access. Tighten after deployment if needed.",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(date:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(npm:*)",
      "Bash(docker compose:*)",
      "Bash(bash:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Edit(protocol/**)",
      "Write(protocol/**)",
      "Edit(templates/**)",
      "Write(templates/**)",
      "Edit(scripts/*.py)",
      "Write(scripts/*.py)",
      "Edit(version.txt)",
      "Write(version.txt)",
      "Edit(.cortex-version)",
      "Write(.cortex-version)",
      "Edit(LICENSE)",
      "Write(LICENSE)",
      "Edit(docs/CORTEX-CHANGELOG.md)",
      "Write(docs/CORTEX-CHANGELOG.md)",
      "Edit(docs/VERBS.md)",
      "Write(docs/VERBS.md)",
      "Edit(README.md)",
      "Write(README.md)",
      "Edit(README-SIMPLE.md)",
      "Write(README-SIMPLE.md)",
      "Edit(docs/PERSONALITIES.md)",
      "Write(docs/PERSONALITIES.md)",
      "Edit(docs/CONNECTORS.md)",
      "Write(docs/CONNECTORS.md)",
      "Edit(docs/SETUP-DESKTOP.md)",
      "Write(docs/SETUP-MOBILE.md)",
      "Edit(personalities/PERSONALITY-BOOTSTRAP.md)",
      "Edit(personalities/PERSONALITY-APEX.md)"
    ]
  }
}
