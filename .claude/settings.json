{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Edit(manifest/framework/protocol/**)",
      "Write(manifest/framework/protocol/**)",
      "Edit(templates/**)",
      "Write(templates/**)",
      "Edit(scripts/*.ts)",
      "Write(scripts/*.ts)",
      "Edit(version.txt)",
      "Write(version.txt)",
      "Edit(.cortex-version)",
      "Write(.cortex-version)",
      "Edit(LICENSE)",
      "Write(LICENSE)",
      "Edit(manifest/framework/CORTEX-CHANGELOG.md)",
      "Write(manifest/framework/CORTEX-CHANGELOG.md)",
      "Edit(manifest/framework/VERBS.md)",
      "Write(manifest/framework/VERBS.md)",
      "Edit(manifest/framework/CORTEX-DEV.md)",
      "Write(manifest/framework/CORTEX-DEV.md)",
      "Edit(ROADMAP.md)",
      "Write(ROADMAP.md)",
      "Edit(README.md)",
      "Write(README.md)",
      "Edit(manifest/framework/README-SIMPLE.md)",
      "Write(manifest/framework/README-SIMPLE.md)",
      "Edit(install/**)",
      "Write(install/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  }
}
